rules_version = '2';

/**
 * Les règles de la base — version simple.
 *
 * L'app est un logiciel interne, pour une seule activité et une petite
 * équipe. Les règles détaillées par site et par rôle (qui voit l'écart,
 * qui ouvre le tiroir, qui écrit chez le voisin) vivaient ici, mais leur
 * complexité provoquait des refus à répétition — « Missing or insufficient
 * permissions » sur des gestes pourtant légitimes, quand une règle
 * dépassait les dix lectures que Firestore lui accorde.
 *
 * On garde la seule barrière qui compte vraiment : il faut être connecté.
 * Un inconnu — un robot qui scanne le web, un visiteur non authentifié —
 * ne peut donc rien lire ni écrire. Tout le contrôle fin (qui voit quoi,
 * qui fait quoi) reste assuré par l'app elle-même, côté interface.
 *
 * La sauvegarde des anciennes règles détaillées est dans
 * `firestore.rules.backup-complexe`, si on veut un jour y revenir.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    /* Connecté = autorisé. Tout compte authentifié par l'app peut lire et
       écrire ; personne d'autre ne touche à la base. */
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
