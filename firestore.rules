rules_version = '2';

/**
 * Les règles de la base.
 *
 * Tout ce que l'app vérifie — qui reconnaît un écart, qui ouvre le tiroir,
 * qui voit quel site — vit dans le navigateur, et le navigateur appartient
 * à celui qui l'utilise. Ouvrir la console suffit à contourner un bouton
 * caché. Ces règles sont la seule barrière que personne ne peut retirer :
 * c'est le serveur qui refuse.
 *
 * Le principe tient en une phrase : on ne touche qu'aux données de son
 * activité, et à l'intérieur, qu'à celles de ses sites.
 *
 * Une limite qu'il faut connaître : lire un document et lister une
 * collection sont deux questions différentes. Firestore valide une
 * requête avant de l'exécuter, sans savoir ce qu'elle rapportera ; une
 * règle de liste ne peut donc pas examiner les documents. Les lectures
 * unitaires (`get`) vérifient le site ; les listes (`list`) se bornent à
 * « avoir une activité ». Un membre de la maison peut donc, en console,
 * lister une collection entière. Il ne peut rien y écrire hors de son
 * site, et ne voit rien d'une autre activité que par cette liste-là.
 * Fermer cela demanderait de porter l'activité sur chaque document et
 * d'exiger le filtre correspondant — un changement de modèle.
 *
 * Ce qu'elles ne font pas : rejouer toute la logique métier. Un écart qui
 * dépasse le solde, un mouvement au mauvais motif — cela reste au code.
 * Les règles ferment ce qui serait grave : lire la caisse d'un autre,
 * écrire chez un concurrent, se nommer gérant soi-même.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // Ce qu'on sait de celui qui demande
    // ---------------------------------------------------------------

    function connecte() {
      return request.auth != null;
    }

    function monUid() {
      return request.auth.uid;
    }

    /**
     * Le profil, lu une fois.
     *
     * Chaque `get()` dans une règle est une lecture facturée et un
     * aller-retour réseau. Écrites naïvement, ces aides relisaient le
     * profil à chaque question posée — six ou huit fois pour un seul
     * document. En local cela ne se voyait pas ; depuis un serveur
     * lointain, chaque page attendait des centaines d'allers-retours.
     *
     * `let` dans une fonction ne coûte qu'une lecture par requête :
     * Firestore mémorise le résultat pour la durée de l'évaluation.
     */
    function aUnProfil() {
      return connecte()
        && exists(/databases/$(database)/documents/users/$(monUid()));
    }

    function profil() {
      return get(/databases/$(database)/documents/users/$(monUid())).data;
    }

    /**
     * L'activité de celui qui demande, ou '' s'il n'en a pas encore.
     *
     * Au premier instant d'un compte, le profil n'existe pas : il va
     * s'écrire, mais l'invitation doit d'abord être trouvée. Toute
     * fonction qui lit le profil doit donc supporter son absence — un
     * `get` sur un document manquant fait échouer la règle entière, et
     * pas seulement la branche où il se trouve.
     */
    function monActivite() {
      return aUnProfil() ? profil().get('activiteId', '') : '';
    }

    function aUneActivite() {
      return monActivite() != '';
    }

    /**
     * Le propriétaire.
     *
     * La réponse se lit sur l'activité, jamais sur le profil.
     *
     * Le profil portait `adminUid` comme raccourci, et une lecture
     * suffisait. Mais c'est l'utilisateur lui-même qui écrit son profil :
     * il lui suffisait de poser `adminUid: <moi>` et `activiteId: <la
     * maison d'un autre>` pour devenir propriétaire chez quelqu'un
     * d'autre — tout voir, tout écrire, tout effacer. La porte s'ouvrait
     * depuis la console du navigateur, sans rien contourner.
     *
     * L'activité, elle, n'appartient qu'à son propriétaire : il est le
     * seul à pouvoir y écrire. C'est donc elle qui répond, au prix d'une
     * lecture de plus. Le `adminUid` du profil reste écrit par l'app —
     * il sert de cache à l'écran — mais plus aucune règle ne le croit.
     *
     * Le rôle `admin` du profil ne fait pas foi non plus, pour la même
     * raison : il s'écrit soi-même.
     */
    function suisProprietaire() {
      return aUnProfil()
        && profil().get('activiteId', '') != ''
        && exists(/databases/$(database)/documents/activites/$(profil().get('activiteId', '')))
        && get(/databases/$(database)/documents/activites/$(profil().get('activiteId', '')))
             .data.get('adminUid', '') == monUid();
    }

    /* La même activité : la frontière que rien ne franchit. Deux
       commerçants sur la même base ne se voient jamais. */
    function memeActivite(activiteId) {
      return activiteId != '' && activiteId == monActivite();
    }

    // ---------------------------------------------------------------
    // Les sites, et ce qu'on y fait
    // ---------------------------------------------------------------

    function siteDe(siteId) {
      return get(/databases/$(database)/documents/sites/$(siteId)).data;
    }

    function siteExiste(siteId) {
      return exists(/databases/$(database)/documents/sites/$(siteId));
    }

    /* Le site appartient-il à ma maison ? Un site porte son activité ;
       les vieux documents portaient l'uid du propriétaire. */
    /* Le site appartient-il à ma maison ? Une lecture du site, une du
       profil — pas davantage. */
    function monSite(siteId) {
      return siteId != '' && connecte() && siteExiste(siteId)
        && (memeActivite(siteDe(siteId).get('activiteId', ''))
          || siteDe(siteId).get('userId', '') == monUid());
    }

    /**
     * Mon rôle sur ce site, ou '' si je n'y travaille pas.
     *
     * Le membre se nomme {siteId}_{uid} : c'est ce qui rend la lecture
     * possible. Une règle ne requête pas — elle ne sait pas chercher
     * « le membre dont le compteUid vaut X » — mais elle lit sans peine
     * un document dont le chemin se déduit de la question posée.
     *
     * Une invitation non encore rattachée garde un identifiant
     * automatique : elle ne donne donc aucun droit tant que la personne
     * ne s'est pas connectée. C'est exactement ce qu'on veut.
     */
    function monRoleSur(siteId) {
      return siteId != '' && connecte()
        && exists(/databases/$(database)/documents/membres/$(siteId + '_' + monUid()))
        && get(/databases/$(database)/documents/membres/$(siteId + '_' + monUid()))
             .data.get('actif', true) == true
        ? get(/databases/$(database)/documents/membres/$(siteId + '_' + monUid()))
            .data.get('role', '') : '';
    }

    /* Travailler sur ce site : le propriétaire entre partout chez lui, un
       membre seulement là où il est inscrit et actif. Le rôle précis
       relève du code ; la règle dit qu'on n'est pas un inconnu. */
    function travailleSur(siteId) {
      return monSite(siteId)
        && (suisProprietaire() || monRoleSur(siteId) != '');
    }

    /* Le site que porte le document, avant ou après écriture. */
    /* Le site d'un document.
     *
     * Presque tous portent `siteId`. Un transfert fait exception : il
     * relie deux sites, et n'en a donc aucun « à lui » — il porte une
     * source et une destination. C'est la source qui l'écrit et qui en
     * répond, comme l'expéditeur répond du colis. */
    function siteDuDoc() {
      return resource == null ? ''
        : resource.data.get('siteId',
            resource.data.get('siteSourceId', ''));
    }

    function siteEnvoye() {
      return request.resource.data.get('siteId',
        request.resource.data.get('siteSourceId', ''));
    }

    /* La destination d'un transfert, quand il en a une. Elle doit
       pouvoir le lire et le confirmer : la marchandise entre chez elle,
       et personne d'autre ne peut constater qu'elle est arrivée. */
    function siteDestDuDoc() {
      return resource == null ? ''
        : resource.data.get('siteDestId', '');
    }

    /* L'autre bout d'un mouvement de transfert.
     *
     * Confirmer une réception ne touche pas qu'au site qui reçoit : la
     * marchandise sort de la source au même instant, et c'est le même
     * geste qui écrit les deux. La règle ne regardait que le site du
     * mouvement, donc le gérant qui recevait se voyait refuser
     * l'écriture chez l'expéditeur — où il ne travaille pas — et la
     * confirmation échouait sans dire pourquoi.
     *
     * Seul un mouvement de transfert ouvre cette porte, et seulement
     * vers le site qu'il désigne lui-même. Elle ne donne aucun droit
     * ailleurs : on peut écrire chez l'autre site ce que ce transfert
     * y fait, rien de plus. */
    function siteLieTransfert() {
      return request.resource.data.get('motif', '') == 'transfert'
        ? request.resource.data.get('siteLieId', '') : '';
    }

    function siteLieExistant() {
      return resource != null && resource.data.get('motif', '') == 'transfert'
        ? resource.data.get('siteLieId', '') : '';
    }

    /* La détention de l'autre site, pendant un transfert précis.
     *
     * Une détention ne porte pas de lien : elle dit un produit et un
     * site, rien de plus. On ne peut donc pas lire sur elle qu'on y
     * touche au titre d'un transfert.
     *
     * Mais le transfert, lui, porte ses deux bouts. La règle va donc le
     * chercher et vérifie trois choses : il existe, la personne
     * travaille à l'une de ses extrémités, et le site de la détention
     * est l'autre. Rien n'est supposé — tout est lu.
     *
     * La porte ne s'ouvre ainsi que vers le site que ce transfert-là
     * désigne, et seulement pour qui en répond à l'autre bout. Un
     * identifiant inventé ne mène nulle part : le document n'existe
     * pas, et la règle refuse. */
    function transfertOuvre(transfertId, siteDetention) {
      return transfertId is string && transfertId != ''
        && exists(/databases/$(database)/documents/transferts/$(transfertId))
        /* La version econome : `transfertLie` passe par `travailleSur`,
           qui lit le site, son activite, son proprietaire puis le membre
           — quatre lectures, et deux fois, pour les deux bouts. Avec la
           lecture du document et celle du transfert, le plafond de dix
           lectures par regle etait franchi, et Firestore repondait
           « permissions » sans dire que c'etait un budget epuise. Meme
           correction que pour les ventes d'un ordre. */
        && transfertLieLeger(
          get(/databases/$(database)/documents/transferts/$(transfertId)).data,
          siteDetention);
    }

    /* Les deux autres dossiers d'un ordre, poussés depuis le premier.
     *
     * Un ordre tient trois documents : le bon de la source, le transfert,
     * et la commande du site qui facture. C'est la source qui les fait
     * avancer — elle tient la marchandise — et chacun de ses pas écrit
     * donc chez l'autre site, où elle ne travaille pas. La règle s'y
     * opposait, et l'écran n'en disait rien de plus qu'un mot anglais.
     *
     * Le lien ne se croit pas sur parole : on va lire le transfert qu'il
     * nomme, et on vérifie qu'il relie bien ces deux sites-là. Un
     * identifiant inventé ne mène nulle part. */
    function ordreOuvre(doc) {
      /* Le site à vérifier est celui du dossier lu, pas celui du
         document qu'on écrit. Les deux coïncident quand on met à jour la
         vente elle-même ; ils divergent dès qu'on écrit un mouvement ou
         une détention pour elle — et la règle cherchait alors le mauvais
         bout du transfert. */
      return doc != null
        && doc.data.get('ordreLien', null) != null
        && transfertOuvre(
          doc.data.ordreLien.get('transfertId', ''),
          doc.data.get('siteId', ''));
    }

    /* Ce qu'une vente d'ordre entraîne : ses mouvements, son document,
     * ses lignes.
     *
     * Livrer la commande du destinataire sort sa marchandise et fige sa
     * marge — des écritures sur son site, faites depuis l'autre bout par
     * celui qui remet. Elles portent toutes `venteId` : la règle remonte
     * à ce dossier, et de là au transfert qui l'a produit. Rien n'est
     * supposé, tout est lu.
     *
     * Une vente ordinaire ne passe pas par là : sans `ordreLien`, la
     * porte reste fermée et le site écrit chez lui comme avant. */
    function venteDOrdre(venteId) {
      return venteId is string && venteId != ''
        && exists(/databases/$(database)/documents/ventes/$(venteId))
        && ordreOuvre(get(/databases/$(database)/documents/ventes/$(venteId)));
    }

    /* Le même lien, lu sur ce qui s'écrit ou sur ce qui existe déjà. */
    function venteLieeEcrite() {
      return request.resource != null
        ? request.resource.data.get('venteId', '') : '';
    }

    function venteLieeExistante() {
      return resource != null ? resource.data.get('venteId', '') : '';
    }

    /* Le même lien, mais lu à moindre coût.
     *
     * Une règle ne peut lire que dix documents par évaluation.
     * `ordreOuvre` passait par `travailleSur`, qui vérifie l'existence du
     * site, son activité, son propriétaire, puis le membre — quatre
     * lectures, et il le faisait deux fois, pour les deux bouts du
     * transfert. Avec la lecture du dossier et celle du transfert, le
     * plafond était franchi et la règle échouait sans rien dire : pas une
     * erreur de permission mal placée, un budget épuisé. C'est ce qui
     * refusait « Marquer prêt » au responsable des commandes, et que
     * relire la logique ne pouvait pas trouver — elle était juste.
     *
     * Ici, le transfert a déjà prouvé que les deux sites travaillent
     * ensemble : c'est lui qui les nomme tous les deux, et il a fallu
     * l'écrire. Il ne reste qu'à vérifier qu'on tient un de ses bouts, et
     * un membre actif suffit à l'établir — une seule lecture de plus.
     */
    function membreActifDe(siteId) {
      return siteId != '' && connecte()
        && exists(/databases/$(database)/documents/membres/$(siteId + '_' + monUid()))
        && get(/databases/$(database)/documents/membres/$(siteId + '_' + monUid()))
             .data.get('actif', true) == true;
    }

    function ordreOuvreLeger(doc) {
      return doc != null
        && doc.data.get('ordreLien', null) != null
        && doc.data.ordreLien.get('transfertId', '') != ''
        && exists(/databases/$(database)/documents/transferts/$(doc.data.ordreLien.transfertId))
        && transfertLieLeger(
          get(/databases/$(database)/documents/transferts/$(doc.data.ordreLien.transfertId)).data,
          doc.data.get('siteId', ''));
    }

    function transfertLieLeger(t, siteDetention) {
      return (t.get('siteSourceId', '') == siteDetention
          && membreActifDe(t.get('siteDestId', '')))
        || (t.get('siteDestId', '') == siteDetention
          && membreActifDe(t.get('siteSourceId', '')));
    }

    function transfertLie(t, siteDetention) {
      return (t.get('siteSourceId', '') == siteDetention
          && travailleSur(t.get('siteDestId', '')))
        || (t.get('siteDestId', '') == siteDetention
          && travailleSur(t.get('siteSourceId', '')));
    }

    // ---------------------------------------------------------------
    // Les comptes
    // ---------------------------------------------------------------

    /* Chacun lit son profil. L'écriture ne porte que sur soi : sans cela,
       on se rattacherait à l'activité d'un autre en une ligne de console.
       Le rôle et l'activité se posent à l'inscription et ne se changent
       plus depuis le navigateur. */
    match /users/{uid} {
      /* Son propre profil d'abord, et sans condition : c'est la première
         chose que l'app lit, souvent avant qu'il existe. Le test du
         propriétaire vient après, quand le sien est là pour répondre. */
      allow read: if connecte()
        && (uid == monUid() || suisProprietaire());
      /* `adminUid` ne s'écrit pas depuis le navigateur.
       *
         Il n'était qu'un cache de ce que porte l'activité, et plus aucune
         règle ne le lit — mais le laisser inscriptible garderait une
         fausse piste dans la base, et la première règle qui le relirait
         par mégarde rouvrirait la porte. L'app le pose par le SDK admin,
         ou pas du tout. */
      allow create: if connecte() && uid == monUid()
        && !('adminUid' in request.resource.data);
      /**
       * Une seule règle d'écriture, et c'est essentiel.
       *
       * Il y en avait deux : une qui gardait le rôle, une autre qui
       * gardait l'activité. Firestore accepte dès qu'UNE règle passe —
       * elles ne s'additionnent pas, elles s'offrent. La première
       * laissait donc `activiteId` libre, et la seconde ne protégeait
       * rien : n'importe quel compte inscrivait l'identifiant de la
       * maison d'un autre commerçant et lisait aussitôt ses sites, ses
       * ventes et ses soldes.
       *
       * `resource == null` d'abord : une écriture sur un document absent
       * s'évalue parfois comme un update — le SDK ne sait pas toujours
       * si le document existe et envoie les deux hypothèses. Sans ce
       * cas, un compte neuf ne pouvait pas écrire son propre profil.
       *
       * Ce qui est verrouillé :
       *
       * `adminUid` — il n'était qu'un cache de ce que porte l'activité,
       * et plus aucune règle ne le lit. Le laisser inscriptible
       * garderait une fausse piste que la prochaine règle écrite par
       * mégarde croirait.
       *
       * `role` — sauf pour se dégrader d'admin à membre, qui répare un
       * rattachement raté. On ne peut que descendre.
       *
       * `activiteId` — il se pose une fois, à la première connexion,
       * depuis l'invitation qui l'apporte, et ne bouge plus d'ici. Une
       * règle ne peut pas vérifier l'invitation elle-même : elle vit
       * sous `membres/{siteId}_{uid}` et le serveur ne devine pas le
       * site. On verrouille donc le champ plutôt que de prétendre
       * contrôler sa valeur ; un rattachement fautif se répare côté
       * gérant, sur l'invitation.
       */
      allow update: if connecte() && uid == monUid()
        && (resource == null || (
          !request.resource.data.diff(resource.data)
            .affectedKeys().hasAny(['adminUid'])
          && (request.resource.data.get('role', '') == resource.data.get('role', '')
            || (resource.data.get('role', '') == 'admin'
              && request.resource.data.get('role', '') == 'membre'))
          && (resource.data.get('activiteId', '') == ''
            || request.resource.data.get('activiteId', '')
                 == resource.data.get('activiteId', ''))));
      allow delete: if false;
    }

    /* L'activité : son propriétaire seul la modifie. Ses membres la lisent
       — le nom s'affiche partout, et `adminUid` sert à reconnaître le
       propriétaire. */
    match /activites/{id} {
      allow get: if connecte()
        && (resource.data.adminUid == monUid() || memeActivite(id));
      /* L'app cherche « l'activité dont je suis l'admin » à la première
         connexion : la requête porte sur son propre uid. */
      allow list: if connecte();
      allow create: if connecte()
        && request.resource.data.adminUid == monUid();
      allow update: if connecte() && resource.data.adminUid == monUid()
        && request.resource.data.adminUid == monUid();
      allow delete: if false;
    }

    /**
     * Les sites d'une activité.
     *
     * Créer ou supprimer un site revient au propriétaire : c'est ouvrir ou
     * fermer une boutique. Le gérant l'exploite, il ne décide pas de son
     * existence.
     */
    match /sites/{id} {
      allow get: if aUneActivite()
        && (resource.data.get('activiteId', '') == monActivite()
          || resource.data.get('userId', '') == monUid());
      allow list: if aUneActivite();
      allow create: if suisProprietaire()
        && request.resource.data.get('activiteId', '') == monActivite();
      allow update: if monSite(id)
        && request.resource.data.get('activiteId', '')
          == resource.data.get('activiteId', '');
      allow delete: if suisProprietaire() && monSite(id);
    }

    /**
     * Qui travaille où, et à quel titre.
     *
     * C'est la collection la plus sensible de la base : y écrire, c'est se
     * distribuer un rôle. Le propriétaire et le gérant du site en
     * décident, personne d'autre — et jamais sur un site qui n'est pas de
     * la maison.
     */
    match /membres/{id} {
      /**
       * Lire un membre, et lister les membres : deux questions.
       *
       * `get` connaît le document et peut donc l'examiner. `list` ne le
       * peut pas : Firestore valide une requête sans savoir ce qu'elle
       * rapportera, et refuse dès qu'une règle interroge `resource.data`.
       * Une liste se borne donc par ce que la requête demande, pas par ce
       * qu'elle reçoit — et ici, par l'activité de celui qui la pose.
       *
       * L'app cherche les membres par adresse au rattachement, et par
       * site ailleurs. Dans les deux cas elle reste dans sa maison ; c'est
       * la frontière que cette règle tient.
       */
      allow get: if aUneActivite()
        && (resource.data.get('compteUid', '') == monUid()
          || monSite(resource.data.get('siteId', '')));
      /**
       * `connecte()`, et non `aUneActivite()`.
       *
       * Au tout premier instant d'un compte, le profil n'existe pas
       * encore : c'est l'invitation qui va dire s'il est membre ou
       * propriétaire, et il faut donc la chercher avant de l'écrire.
       * Exiger une activité ici rendait cette recherche impossible, et
       * l'échec passait pour « personne ne l'a invité » : chaque employé
       * se retrouvait propriétaire d'une activité à lui.
       *
       * Ce que cela ouvre : un compte connecté peut lister les membres.
       * Il y lit des adresses et des rôles, rien de plus — ni chiffre, ni
       * mouvement, ni stock. C'est le prix d'une inscription qui sait où
       * elle atterrit, et il est moindre que celui d'un employé devenu
       * administrateur.
       */
      allow list: if connecte();
      /**
       * Deux façons de créer un membre.
       *
       * Le rattachement d'abord, et sans lire le profil : au premier
       * instant d'un compte il n'existe pas, et une règle qui le lit
       * échoue alors entièrement — pas seulement la branche concernée.
       * Le nom du document suffit à prouver le droit : il porte l'uid de
       * celui qui écrit, que lui seul peut fournir.
       *
       * L'invitation ensuite, posée par qui dirige le site.
       */
      allow create: if connecte() && (
        (id == siteEnvoye() + '_' + monUid()
          && request.resource.data.get('compteUid', '') == monUid())
        || (monSite(siteEnvoye())
          && (suisProprietaire() || monRoleSur(siteEnvoye()) == 'gerant')));
      /* Le rattachement efface l'invitation qu'il vient de recopier. Une
         invitation n'appartient à personne tant qu'aucun compte ne la
         porte — d'où le `compteUid == null` : on ne prend que ce qui
         attend, jamais le membre d'un autre. */
      /* Une invitation qu'aucun compte ne porte n'appartient à personne :
         celui qui vient de la recopier sous son nom l'efface. Ce test ne
         lit pas le profil, qui n'existe pas encore à cet instant. */
      allow update, delete: if connecte()
        && (resource.data.get('compteUid', null) == null
          || (monSite(siteDuDoc())
            && (suisProprietaire() || monRoleSur(siteDuDoc()) == 'gerant')));
    }

    // ---------------------------------------------------------------
    // La caisse
    // ---------------------------------------------------------------

    /**
     * Le registre : un fait s'enregistre, il ne s'annote pas.
     *
     * Aucune modification, aucune suppression. Une erreur se corrige par
     * une contrepassation — une écriture de plus, qui dit ce qui s'est
     * passé. Effacer une ligne ferait mentir la suite des soldes, et
     * surtout laisserait disparaître l'argent sans trace.
     */
    match /mouvements_caisse/{id} {
      /* `get` examine le document ; `list` ne le peut pas — Firestore
         valide une requête sans savoir ce qu'elle rapportera. La liste se
         borne donc à l'activité, et le document à son site. */
      allow get: if travailleSur(resource.data.get('siteId', ''));
      allow list: if aUneActivite();
      allow create: if travailleSur(siteEnvoye());
      /**
       * Le registre ne se recrit pas — sauf pour dire qu'une ligne a ete
       * contre-passee.
       *
       * `update: false` refusait aussi cette marque-la. L'annulation
       * ecrivait donc sa contre-passation, puis echouait a marquer
       * l'original : l'ecran affichait une erreur, le mouvement restait
       * annulable, et chaque nouveau clic ajoutait une contre-passation
       * de plus. Trois clics, trois fois l'argent rentre.
       *
       * `annuleParId` est le seul champ qui bouge, et une seule fois :
       * il doit etre vide avant, rempli apres. Le montant, le sens, la
       * date et l'auteur restent ce qu'ils etaient — c'est tout
       * l'interet d'un registre.
       */
      allow update: if travailleSur(resource.data.get('siteId', ''))
        && resource.data.get('annuleParId', '') == ''
        && request.resource.data.get('annuleParId', '') != ''
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['annuleParId']);
      allow delete: if false;
    }

    /**
     * Ce qui attend le tiroir.
     *
     * Celui qui déclare crée ; le caissier tranche, et cela passe par une
     * mise à jour. On ne supprime pas : une déclaration refusée a eu lieu,
     * et le refus fait partie de l'histoire.
     */
    match /mouvements_attente/{id} {
      /* `get` examine le document ; `list` ne le peut pas — Firestore
         valide une requête sans savoir ce qu'elle rapportera. La liste se
         borne donc à l'activité, et le document à son site. */
      allow get: if travailleSur(resource.data.get('siteId', ''));
      allow list: if aUneActivite();
      allow create: if travailleSur(siteEnvoye())
        && request.resource.data.get('userId', '') == monUid();
      /**
       * Seul le caissier tranche, et seulement ce qui attend encore.
       *
       * La règle disait `travailleSur(siteDuDoc())` : le gérant qui
       * déclare un mouvement pouvait, de la même main, le passer à
       * `autorise`. Toute la séparation entre décider une dépense et
       * ouvrir le tiroir tenait alors au fait qu'aucun bouton ne le
       * proposait — et un bouton caché n'est pas une permission.
       *
       * Trois gardes :
       *
       * le rôle — `caissier`, ou le propriétaire, qui est partout chez
       * lui et reste caissier quand le site n'en a pas ;
       *
       * l'état de départ — on ne tranche que ce qui attend. Sans cela un
       * refus se rouvrait en autorisation, et l'écart déjà constaté
       * restait sur les comptes ;
       *
       * les champs — la demande elle-même ne se réécrit pas. Son
       * montant, son motif et son auteur sont ce que le caissier doit
       * juger : les laisser modifiables permettait d'autoriser autre
       * chose que ce qui avait été déclaré.
       */
      allow update: if travailleSur(siteDuDoc())
        && (monRoleSur(siteDuDoc()) == 'caissier' || suisProprietaire())
        && resource.data.get('etat', '') == 'en_attente'
        && request.resource.data.get('etat', '') in ['autorise', 'refuse']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'etat', 'montantAutorise', 'autorisePar', 'autoriseParNom',
            'dateAutorisation', 'constat',
            'mouvementCaisseId', 'mouvementEcartId',
          ]);
      allow delete: if false;
    }

    /**
     * Les écarts de caisse.
     *
     * La règle « jamais son propre constat » se tient ici aussi, et non
     * seulement dans le code : reconnaître son propre manque reviendrait à
     * se décharger soi-même. Le serveur refuse que le constatant se nomme
     * reconnaisseur.
     *
     * Le constat lui-même ne bouge plus : seul son état se tranche.
     */
    match /ecarts_caisse/{id} {
      /* `get` examine le document ; `list` ne le peut pas — Firestore
         valide une requête sans savoir ce qu'elle rapportera. La liste se
         borne donc à l'activité, et le document à son site. */
      allow get: if travailleSur(resource.data.get('siteId', ''));
      allow list: if aUneActivite();
      allow create: if travailleSur(siteEnvoye())
        && request.resource.data.get('parUid', '') == monUid()
        && request.resource.data.get('etat', '') == 'en_attente'
        && request.resource.data.get('montant', 0) > 0;
      /* Trancher, et rien d'autre : le montant, le sens et l'auteur du
         constat sont figés. Et jamais par celui qui a constaté. */
      allow update: if travailleSur(siteDuDoc())
        && resource.data.get('parUid', '') != monUid()
        && resource.data.get('etat', '') == 'en_attente'
        && request.resource.data.get('parUid', '') == resource.data.get('parUid', '')
        && request.resource.data.get('montant', 0) == resource.data.get('montant', 0)
        && request.resource.data.get('sens', '') == resource.data.get('sens', '')
        && request.resource.data.get('reconnuParUid', '') == monUid();
      allow delete: if false;
    }

    /**
     * Les compteurs de caisse.
     *
     * Ils donnent son numéro à chaque écriture et gardent le solde courant.
     * Ce ne sont pas des données qu'on lit : ce sont les outils du
     * registre, manipulés dans une transaction que personne n'appelle à la
     * main.
     *
     * Le site se déduit de leur nom — `{siteId}_2026`, `{siteId}_solde` —
     * et c'est heureux : une règle ne requête pas, mais elle sait comparer
     * un chemin. Le solde ne s'écrit donc que par qui travaille là.
     *
     * Rien ne s'efface : un compteur remis à zéro ferait recommencer la
     * numérotation, et deux écritures porteraient le même numéro.
     */
    match /caisse_compteurs/{id} {
      /**
       * Un outil, pas une donnée — mais un outil qui tient le solde.
       *
       * Ces documents naissent dans la transaction qui écrit au registre,
       * pour donner un numéro et garder le solde courant. Personne ne les
       * appelle à la main.
       *
       * La règle disait `aUneActivite()` : tout compte inscrit, de
       * n'importe quelle maison, pouvait réécrire le solde de caisse d'un
       * autre commerçant. Le commentaire s'en excusait en expliquant
       * qu'on ne savait pas retrouver le site — il fallait découper
       * `{siteId}_2026`, ce que le langage des règles fait mal.
       *
       * Mais le document porte `siteId` en clair : il n'y a rien à
       * découper, il suffit de le lire. La borne existait sous la main,
       * et la base restait ouverte pour une difficulté qui n'en était
       * pas une.
       *
       * Reste la création, qui n'a pas d'`resource` à lire : on exige
       * alors que le `siteId` écrit soit un site où l'on travaille.
       *
       * Rien ne s'efface : un compteur remis à zéro ferait porter le même
       * numéro à deux écritures, et le registre cesserait de prouver sa
       * continuité.
       */
      /* Un compteur absent se lit comme un document vide, pas comme un
         refus : `resource` vaut alors `null`, et le site se deduit du nom
         — c'est la premiere lecture que fait toute ecriture en caisse,
         avant meme que le compteur existe. */
      allow read: if resource == null
        ? travailleSur(id.split('_')[0])
        : travailleSur(resource.data.get('siteId', ''));
      allow create: if travailleSur(request.resource.data.get('siteId', ''))
        /* Le nom dit le site : les deux doivent s'accorder, sinon un
           compteur se logerait sous le nom d'un autre. */
        && request.resource.data.get('siteId', '') == id.split('_')[0];
      allow update: if travailleSur(resource.data.get('siteId', ''))
        /* Le compteur ne change pas de site en cours de route. */
        && request.resource.data.get('siteId', '') == resource.data.get('siteId', '');
      allow delete: if false;
    }

    /**
     * Les retours de marchandise.
     *
     * Un dossier s'ouvre, se traite, puis se confirme — et c'est la
     * confirmation qui fait tout bouger : le stock revient, une dette
     * s'éteint ou de l'argent part vers la caisse.
     *
     * La règle tient ce que le code tient déjà : on ne confirme pas le
     * retour qu'on a ouvert soi-même. Un gérant seul déclarerait sinon
     * une marchandise rendue qui n'a jamais quitté la boutique, et
     * encaisserait le remboursement d'un stock toujours en rayon.
     *
     * L'auteur ne se réécrit pas : c'est lui qui rend la séparation
     * vérifiable après coup.
     */
    match /retours_dossiers/{id} {
      allow get: if travailleSur(resource.data.get('siteId', ''));
      allow list: if aUneActivite();
      allow create: if travailleSur(siteEnvoye())
        && request.resource.data.get('parUid', '') == monUid()
        && request.resource.data.get('etat', '') == 'en_attente';
      /* Avancer d'une etape, ou confirmer.
       *
         L'auteur d'ouverture ne change jamais, et la valeur du dossier
         non plus : ce sont les deux faits sur lesquels tout le reste
         s'appuie.
       *
         Confirmer demandait un autre que celui qui a ouvert. La
         separation des deux mains vaut entre employes — l'un declare,
         l'autre constate — mais pas contre celui a qui appartient la
         marchandise : l'y soumettre l'obligeait a demander a un employe
         de valider son propre travail, et le dossier restait bloque,
         stock pas rentre, client ni rembourse ni credite.
       *
         Le proprietaire peut donc confirmer ce qu'il a ouvert. Pour un
         employe la regle tient, et les deux noms restent inscrits
         separement : qui a ouvert, qui a confirme. */
      allow update: if travailleSur(siteDuDoc())
        && request.resource.data.get('parUid', '') == resource.data.get('parUid', '')
        && request.resource.data.get('valeurTotale', 0) == resource.data.get('valeurTotale', 0)
        && (request.resource.data.get('confirmeParUid', '') == ''
          || request.resource.data.get('confirmeParUid', '') != resource.data.get('parUid', '')
          || suisProprietaire());
      /* Un retour annulé reste au registre : il raconte une tentative. */
      allow delete: if false;
    }

    /**
     * Les mouvements de stock déclarés.
     *
     * Même forme qu'un retour, et pour la même raison : celui qui
     * déclare une perte ne doit pas être celui qui la constate. La règle
     * tient les deux bouts — l'auteur ne change jamais, et le
     * confirmateur ne peut pas être lui.
     */
    match /ajustements/{id} {
      allow get: if travailleSur(resource.data.get('siteId', ''));
      allow list: if aUneActivite();
      allow create: if travailleSur(siteEnvoye())
        && request.resource.data.get('parUid', '') == monUid()
        && request.resource.data.get('etat', '') == 'declare';
      /* Confirmer ce qu'on a soi-même déclaré est refusé : séparées, les
         deux mains ne peuvent pas s'entendre, et c'est cette séparation
         qui rend le registre croyable.

         Elle suppose qu'une seconde main existe. Chez un commerçant qui
         tient seul sa boutique — ou qui n'a nommé personne aux commandes
         — le dossier resterait ouvert pour toujours : il faudrait
         inventer un compte, ou se donner un rôle qu'on n'exerce pas,
         pour fermer ce qu'on a ouvert. Le registre dirait alors deux
         personnes là où il n'y en a qu'une.

         Le propriétaire fait donc exception, et lui seul : son nom
         s'inscrit en confirmation comme celui de n'importe qui, et
         l'historique dit que c'est lui. Le jour où un responsable des
         commandes est nommé, l'app cesse d'emprunter ce chemin.

         La règle ne peut pas compter les membres — une règle ne lit pas
         une collection. Elle borne ce qu'elle sait borner : c'est le
         propriétaire, et personne d'autre. */
      allow update: if travailleSur(siteDuDoc())
        && request.resource.data.get('parUid', '') == resource.data.get('parUid', '')
        && (request.resource.data.get('confirmeParUid', '') == ''
          || request.resource.data.get('confirmeParUid', '') != resource.data.get('parUid', '')
          || suisProprietaire());
      /* Un mouvement annulé reste au registre : il raconte une tentative. */
      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // Le reste : même frontière, moins de cérémonie
    // ---------------------------------------------------------------

    /**
     * Les collections rattachées à un site.
     *
     * Elles portent toutes `siteId` : marchandise, dossiers, recouvrement,
     * paie. La règle est la même — on y travaille si le site est de sa
     * maison et qu'on y est inscrit. Le détail de qui fait quoi reste au
     * code, qui le sait mieux qu'une règle.
     */
    match /{col}/{id} {
      allow get: if col in [
          'achats', 'ventes', 'lignes_vente', 'transferts', 'preparations',
          'receptions', 'mouvements', 'mouvements_stock', 'produits_site',
          'missions_paiement', 'versements', 'documents',
          'recouvrement_journal', 'recouvrement_suivis',
          'recouvrement_versements', 'recouvrement_config',
          'recouvrement_config_defaut',
          'employes', 'employe_avances', 'employe_avance_configs',
          'employe_prelevements', 'employe_remunerations',
          'employe_rem_configs', 'employe_rem_assignations',
          'employe_versements',
          'vente_montants_configs',
          /* La marchandise qui vient de loin : un achat avec le temps en
             plus. Elle vise un site, et c'est lui qui la comptera. */
          'importations'
        ]
        && (travailleSur(siteDuDoc())
          /* Un transfert se lit des deux bouts : celui qui envoie et
             celui qui reçoit. */
          || travailleSur(siteDestDuDoc())
          /* Les dossiers de l'autre bout d'un ordre.
           *
           * L'écriture croisée était permise plus bas, mais pas la
           * lecture — et elle la précède toujours : `ordreOuvre(resource)`
           * lit le document avant de juger, et le code lit la vente du
           * destinataire avant de la faire avancer. Autoriser d'écrire ce
           * qu'on ne peut pas lire n'autorise rien : la règle d'écriture
           * ne pouvait jamais être atteinte. C'est ce qui refusait
           * « Marquer prêt » au responsable des commandes.
           *
           * Le lien ne suffit pas à lui seul : on remonte au transfert,
           * qui porte les deux sites, et on exige d'en tenir un bout. */
          || (col in ['ventes', 'achats', 'transferts', 'lignes_vente']
            && ordreOuvreLeger(resource)));

      /* La liste ne sait pas ce qu'elle rapportera : on la borne à la
         maison, le site se vérifie à chaque document lu et à chaque
         écriture. */
      allow list: if aUneActivite();

      allow create: if col in [
          'achats', 'ventes', 'lignes_vente', 'transferts', 'preparations',
          'receptions', 'mouvements', 'mouvements_stock', 'produits_site',
          'missions_paiement', 'versements', 'documents',
          'recouvrement_journal', 'recouvrement_suivis',
          'recouvrement_versements', 'recouvrement_config',
          'recouvrement_config_defaut',
          'employes', 'employe_avances', 'employe_avance_configs',
          'employe_prelevements', 'employe_remunerations',
          'employe_rem_configs', 'employe_rem_assignations',
          'employe_versements',
          'vente_montants_configs',
          /* La marchandise qui vient de loin : un achat avec le temps en
             plus. Elle vise un site, et c'est lui qui la comptera. */
          'importations'
        ]
        && (travailleSur(siteEnvoye())
          /* Les deux mouvements d'un transfert naissent ensemble. */
          || travailleSur(siteLieTransfert())
          /* La détention de l'autre site, pendant un transfert ou une
             livraison d'ordre : le dossier est lu, et il doit désigner
             ce site-là. */
          || (col == 'produits_site'
            && (transfertOuvre(
                  request.resource.data.get('transfertOuvrant', ''),
                  siteEnvoye())
              || venteDOrdre(request.resource.data.get('venteOuvrante', ''))))
          /* Ce que la livraison d'un ordre écrit chez le destinataire. */
          || (col in ['mouvements', 'documents', 'lignes_vente']
            && venteDOrdre(venteLieeEcrite())));

      allow update, delete: if col in [
          'achats', 'ventes', 'lignes_vente', 'transferts', 'preparations',
          'receptions', 'mouvements', 'mouvements_stock', 'produits_site',
          'missions_paiement', 'versements', 'documents',
          'recouvrement_journal', 'recouvrement_suivis',
          'recouvrement_versements', 'recouvrement_config',
          'recouvrement_config_defaut',
          'employes', 'employe_avances', 'employe_avance_configs',
          'employe_prelevements', 'employe_remunerations',
          'employe_rem_configs', 'employe_rem_assignations',
          'employe_versements',
          'vente_montants_configs',
          /* La marchandise qui vient de loin : un achat avec le temps en
             plus. Elle vise un site, et c'est lui qui la comptera. */
          'importations'
        ]
        /* Un transfert se confirme à l'arrivée : la destination écrit
           ce qu'elle a réellement reçu, et elle seule peut le constater. */
        /* L'ordre des branches decide, pas seulement leur contenu.
         *
           Une regle ne peut lire que dix documents, et un `||` evalue
           dans l'ordre : les quatre `travailleSur` qui ouvraient cette
           liste coutent jusqu'a quatre lectures chacun. Le budget etait
           epuise avant d'atteindre la branche du transfert, et Firestore
           repondait « permissions » sans dire que c'etait un plafond.
           Les branches econnomes passent donc devant. */
        && ((col == 'produits_site'
            && transfertOuvre(
              request.resource.data.get('transfertOuvrant', ''),
              siteDuDoc()))
          || travailleSur(siteDuDoc())
          || travailleSur(siteDestDuDoc())
          || travailleSur(siteLieExistant())
          || travailleSur(siteLieTransfert())
          /* Le dossier qu'un ordre fait avancer depuis l'autre bout, et
             ce que sa livraison entraîne. */
          /* Le dossier de l'autre bout d'un ordre, et l'achat qui porte
             la dette entre les deux sites. La version économe : voir
             `ordreOuvreLeger` — le plafond de dix lectures par règle est
             atteint sans elle. */
          || (col in ['ventes', 'achats'] && ordreOuvreLeger(resource))
          || (col in ['mouvements', 'documents', 'lignes_vente']
            && (venteDOrdre(venteLieeExistante())
              || venteDOrdre(venteLieeEcrite())))
          || (col == 'produits_site'
            && venteDOrdre(request.resource.data.get('venteOuvrante', '')))
          || (col == 'produits_site'
            && transfertOuvre(
              request.resource.data.get('transfertOuvrant', ''),
              siteDuDoc())))
        /**
         * Ce qui prouve ne s'efface pas.
         *
         * `update` et `delete` partageaient la meme regle : tout ce qu'un
         * membre pouvait corriger, il pouvait l'effacer. Supprimer une
         * vente livree faisait disparaitre la creance avec elle — le
         * client ne devait plus rien, et rien ne disait qu'une facture
         * avait existe. Les mouvements, eux, sont la source du cout moyen
         * et du stock : les effacer rend l'inventaire indemontrable.
         *
         * L'app ne supprime d'ailleurs aucun de ces documents. Elle
         * n'efface que des configurations et des fiches, et `lignes_vente`
         * — qui se reecrit a chaque fois que les lignes d'un dossier
         * changent, et disparait quand il est annule. C'est le seul de
         * cette liste a disparaitre legitimement.
         *
         * Une erreur se corrige par une ecriture contraire : un retour,
         * une annulation, une contre-passation. Jamais en faisant
         * disparaitre la trace.
         */
        && (request.method != 'delete'
          || col == 'lignes_vente');
    }

    /**
     * Produits, partenaires, catégories : par site.
     *
     * On les croirait communs à la maison — un article se vend partout —
     * mais l'app les cherche par `siteId`, et c'est ce qu'il faut suivre.
     * Une règle qui exige un champ que les documents ne portent pas ne
     * protège rien : elle rend seulement l'écran vide.
     */
    /* Le produit appartient à la maison, pas à un site : c'est ce que
       suppose un transfert, où deux boutiques parlent du même article. Il
       porte donc `activiteId` et jamais `siteId` — vérifié sur les
       documents, pas deviné. */
    match /produits/{id} {
      allow get: if memeActivite(resource.data.get('activiteId', ''));
      allow list: if aUneActivite();
      allow create: if memeActivite(request.resource.data.get('activiteId', ''));
      allow update, delete: if memeActivite(resource.data.get('activiteId', ''));
    }

    /**
     * Les partenaires appartiennent à celui qui les inscrit.
     *
     * L'app les cherche par `userId` : chacun tient son carnet, et le
     * gérant ne commerce pas forcément avec les fournisseurs du
     * propriétaire. Exiger `activiteId` ici — que ces documents ne portent
     * pas — rendait tout illisible : « Aucun fournisseur » sur un site qui
     * en avait un.
     *
     * La frontière reste le site : on ne lit pas le carnet d'un autre
     * commerçant, on lit celui de la boutique où l'on travaille.
     */
    match /partenaires/{id} {
      allow get: if travailleSur(resource.data.get('siteId', ''));
      allow list: if aUneActivite();
      allow create: if travailleSur(siteEnvoye());
      allow update, delete: if travailleSur(siteDuDoc());
    }

    match /categories_partenaire/{id} {
      allow get: if travailleSur(resource.data.get('siteId', ''));
      allow list: if aUneActivite();
      allow create: if travailleSur(siteEnvoye());
      allow update, delete: if travailleSur(siteDuDoc());
    }

    /* Tout le reste est fermé. Une collection qu'on ajoutera demain
       n'entrera pas dans la base par oubli : il faudra l'écrire ici, et
       donc se demander qui a le droit d'y toucher. */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
